"""Focused declarations for the Z3 API used by distribution specifications."""
from collections.abc import Sequence
from typing import overload

class ExprRef:
    def __eq__(self, other: object) -> BoolRef: ...
    def __ne__(self, other: object) -> BoolRef: ...
    def __str__(self) -> str: ...
class BoolRef(ExprRef): ...
class ArithRef(ExprRef):
    def __add__(self, other: ArithRef | int | float) -> ArithRef: ...
    def __radd__(self, other: int | float) -> ArithRef: ...
    def __sub__(self, other: ArithRef | int | float) -> ArithRef: ...
    def __mul__(self, other: ArithRef | int | float) -> ArithRef: ...
    def __rmul__(self, other: int | float) -> ArithRef: ...
    def __lt__(self, other: ArithRef | int | float) -> BoolRef: ...
    def __le__(self, other: ArithRef | int | float) -> BoolRef: ...
    def __gt__(self, other: ArithRef | int | float) -> BoolRef: ...
    def __ge__(self, other: ArithRef | int | float) -> BoolRef: ...
class IntNumRef(ArithRef):
    def as_long(self) -> int: ...
class CheckSatResult:
    def __eq__(self, other: object) -> bool: ...
class ModelRef:
    def eval(self, expression: ExprRef, model_completion: bool = ...) -> ExprRef: ...
class Solver:
    def __init__(self) -> None: ...
    def add(self, *expressions: BoolRef | bool) -> None: ...
    def assert_and_track(self, expression: BoolRef, name: str) -> None: ...
    def set(self, **options: int | bool) -> None: ...
    def check(self) -> CheckSatResult: ...
    def model(self) -> ModelRef: ...
    def reason_unknown(self) -> str: ...
    def unsat_core(self) -> Sequence[BoolRef]: ...
    def push(self) -> None: ...
    def pop(self) -> None: ...
sat: CheckSatResult
unsat: CheckSatResult
unknown: CheckSatResult
def Bool(name: str) -> BoolRef: ...
def BoolVal(value: bool) -> BoolRef: ...
def Int(name: str) -> ArithRef: ...
def IntVal(value: int) -> IntNumRef: ...
def And(*expressions: BoolRef | bool) -> BoolRef: ...
def Or(*expressions: BoolRef | bool) -> BoolRef: ...
def Not(expression: BoolRef | bool) -> BoolRef: ...
def Implies(left: BoolRef | bool, right: BoolRef | bool) -> BoolRef: ...
def Xor(left: BoolRef | bool, right: BoolRef | bool) -> BoolRef: ...
def PbEq(expressions: Sequence[tuple[BoolRef, int]], value: int) -> BoolRef: ...
def PbLe(expressions: Sequence[tuple[BoolRef, int]], value: int) -> BoolRef: ...
def PbGe(expressions: Sequence[tuple[BoolRef, int]], value: int) -> BoolRef: ...
def Sum(*expressions: ArithRef | int) -> ArithRef: ...
@overload
def If(condition: BoolRef, left: int | ArithRef, right: int | ArithRef) -> ArithRef: ...
@overload
def If(condition: BoolRef, left: BoolRef | bool, right: BoolRef | bool) -> BoolRef: ...
def is_true(expression: ExprRef) -> bool: ...
def is_int_value(expression: ExprRef) -> bool: ...
