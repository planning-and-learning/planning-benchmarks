from typing import Any
class Term:
    functor: Any
    args: tuple[Any, ...]
    value: Any
    def __init__(self, functor: Any, *args: Any, **options: Any) -> None: ...
    def is_constant(self) -> bool: ...
    def is_ground(self) -> bool: ...
    def compute_value(self, functions: Any = ...) -> Any: ...
    def __float__(self) -> float: ...
class Constant(Term):
    FLOAT_PRECISION: int | None
    def __init__(self, value: Any, location: Any = ..., **options: Any) -> None: ...
    def is_float(self) -> bool: ...
    def is_integer(self) -> bool: ...
def unquote(s: str) -> str: ...
def term2list(term: Term, deep: bool = ...) -> list[Any]: ...

def list2term(values: list[Any]) -> Term: ...
