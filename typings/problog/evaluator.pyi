from typing import Any
class Semiring:
    def one(self) -> Any: ...
    def zero(self) -> Any: ...
    def is_one(self, value: Any) -> bool: ...
    def is_zero(self, value: Any) -> bool: ...
    def plus(self, a: Any, b: Any) -> Any: ...
    def times(self, a: Any, b: Any) -> Any: ...
    def negate(self, a: Any) -> Any: ...
    def normalize(self, a: Any, z: Any) -> Any: ...
    def value(self, a: Any) -> Any: ...
    def is_dsp(self) -> bool: ...
    def in_domain(self, a: Any) -> bool: ...
    def result_in_domain(self, a: Any) -> bool: ...
