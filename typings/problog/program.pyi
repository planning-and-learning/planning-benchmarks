from typing import Any
from collections.abc import Iterator
from .logic import Constant, Term
class ExtendedPrologFactory:
    loc_id: Any
    def __init__(self, **options: Any) -> None: ...
    def build_constant(self, value: Any, location: Any = ...) -> Constant: ...
    def build_unop(self, functor: str, operand: Term, location: Any = ..., **extra: Any) -> Term: ...
    def build_function(self, functor: str, arguments: tuple[Term, ...], location: Any = ..., **extra: Any) -> Term: ...
class PrologString:
    def __init__(self, string: str, **options: Any) -> None: ...
    def __iter__(self) -> Iterator[Term]: ...
